@ We need CMake 3.24 or newer and C++20, the latter because EnTT~4 requires
it. A build without an explicit type is an optimized \emph{Release} build:
ray tracing a scene in a debug build is no fun.

<<Declare the project and the language standard>>=
cmake_minimum_required(VERSION 3.24)
project(UsdOptixViewer VERSION 0.1.0 LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release)
endif()
@ Finding the tools. The tools were first installed for one user under
\lpfile{\textasciitilde/.local/opt} and later for everybody under
\lpfile{/opt/viztools}, with CUDA in \lpfile{/usr/local/cuda-13.2}. The
project prefers the system-wide copy and falls back to the personal one; every
location can also be overridden from the command line or the environment.

<<Locate the visualization tools>>=
# ---------------------------------------------------------------------------
# Dependencies. Locations can be given through CMAKE_PREFIX_PATH or the
# variables / environment variables below (see /etc/profile.d/viztools.sh).
# Defaults to the all-users install in /opt/viztools, falling back to the
# per-user install in ~/.local/opt.
# ---------------------------------------------------------------------------
<<Choose the root of the installed tools and of CUDA>>

<<Find the OptiX headers>>

<<Find the Dear ImGui sources>>

<<Find SDL3, EnTT, OpenUSD and CUDA>>
@ The variable [[VIZ_PREFIX]] records the root of the tools. CUDA has its own
rule: an explicit [[CUDAToolkit_ROOT]] wins, then the [[CUDA_HOME]] variable
set by the login scripts, then the standard system directory.

<<Choose the root of the installed tools and of CUDA>>=
if(EXISTS "/opt/viztools")
  set(_vizDefault "/opt/viztools")
else()
  set(_vizDefault "$ENV{HOME}/.local/opt")
endif()
set(VIZ_PREFIX "${_vizDefault}" CACHE PATH "Root of the installed visualization tools")
if(NOT DEFINED CUDAToolkit_ROOT)
  if(DEFINED ENV{CUDA_HOME})
    set(CUDAToolkit_ROOT "$ENV{CUDA_HOME}")
  elseif(EXISTS "/usr/local/cuda-13.2")
    set(CUDAToolkit_ROOT "/usr/local/cuda-13.2")
  else()
    set(CUDAToolkit_ROOT "${VIZ_PREFIX}/cuda-13.2")
  endif()
endif()
@ OptiX is a header-only SDK: the implementation ships inside the NVIDIA
driver, and the headers only declare a table of function pointers that is
filled in at run time. All we need, then, is the directory that contains
\lpfile{optix.h}.

<<Find the OptiX headers>>=
set(OptiX_INSTALL_DIR "$ENV{OptiX_INSTALL_DIR}" CACHE PATH "OptiX SDK root (contains include/optix.h)")
if(NOT OptiX_INSTALL_DIR)
  set(OptiX_INSTALL_DIR "${VIZ_PREFIX}/optix-9.1.0" CACHE PATH "" FORCE)
endif()
find_path(OptiX_INCLUDE_DIR optix.h PATHS "${OptiX_INSTALL_DIR}/include" REQUIRED NO_DEFAULT_PATH)
@ Dear ImGui is distributed as source files to be compiled into each
application, so we look for its directory rather than for a package.

<<Find the Dear ImGui sources>>=
set(IMGUI_DIR "$ENV{IMGUI_DIR}" CACHE PATH "Dear ImGui source directory")
if(NOT IMGUI_DIR)
  set(IMGUI_DIR "${VIZ_PREFIX}/imgui-1.93.0" CACHE PATH "" FORCE)
endif()
if(NOT EXISTS "${IMGUI_DIR}/imgui.h")
  message(FATAL_ERROR "imgui.h not found in IMGUI_DIR=${IMGUI_DIR}")
endif()
@ The remaining dependencies provide CMake package files. OpenUSD's package
is called \texttt{pxr}, after Pixar.

<<Find SDL3, EnTT, OpenUSD and CUDA>>=
list(APPEND CMAKE_PREFIX_PATH "${VIZ_PREFIX}/sdl3" "${VIZ_PREFIX}/entt-4.0.0" "${VIZ_PREFIX}/usd-26.11")

find_package(CUDAToolkit 12 REQUIRED)
find_package(SDL3 REQUIRED CONFIG)
find_package(EnTT REQUIRED CONFIG)
find_package(pxr REQUIRED CONFIG)
@* Device code. The programs that run on the GPU (described in the part on
device programs) are written in CUDA
C++, but OptiX does not take machine code: it takes PTX, NVIDIA's portable
assembly language, and compiles it for the actual GPU when the pipeline is
created. We ask \texttt{nvcc} for PTX targeting the virtual architecture
\texttt{compute\_75}, the oldest one supported by CUDA~13, so that the same
executable runs on any recent GPU. The warning 20044 that we silence is
\texttt{nvcc}'s remark that an \textbf{extern} declaration of the launch
parameters is treated as a definition, which is exactly what OptiX expects.

The PTX text is then turned into a C++ source file by a small CMake script,
<<UsdOptixViewer/cmake/EmbedFile.cmake>>, and compiled into the executable. The viewer therefore
needs no data files at run time.

<<Compile the device programs to PTX and embed them>>=
# ---------------------------------------------------------------------------
# OptiX device code: compiled to PTX with nvcc and embedded into the binary.
# ---------------------------------------------------------------------------
set(OPTIX_ARCH "compute_75" CACHE STRING "Virtual architecture used for the OptiX PTX")
set(PTX_FILE "${CMAKE_CURRENT_BINARY_DIR}/devicePrograms.ptx")
set(PTX_CPP  "${CMAKE_CURRENT_BINARY_DIR}/devicePrograms_ptx.cpp")
add_custom_command(
  OUTPUT "${PTX_FILE}"
  COMMAND "${CUDAToolkit_NVCC_EXECUTABLE}" -ptx -arch=${OPTIX_ARCH} -std=c++17 --use_fast_math -diag-suppress 20044
          -ccbin "${CMAKE_CXX_COMPILER}"
          -I "${OptiX_INCLUDE_DIR}" -I "${CMAKE_CURRENT_SOURCE_DIR}/src"
          "${CMAKE_CURRENT_SOURCE_DIR}/src/devicePrograms.cu" -o "${PTX_FILE}"
  DEPENDS src/devicePrograms.cu src/LaunchParams.h
  COMMENT "Compiling OptiX programs to PTX")
add_custom_command(
  OUTPUT "${PTX_CPP}"
  COMMAND "${CMAKE_COMMAND}" -DINPUT=${PTX_FILE} -DOUTPUT=${PTX_CPP} -DSYMBOL=g_devicePrograms
          -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/EmbedFile.cmake"
  DEPENDS "${PTX_FILE}" cmake/EmbedFile.cmake
  COMMENT "Embedding PTX")
@* The executable. Dear ImGui and its two back ends (SDL3 for input,
SDL\_Renderer for drawing) become a static library. The viewer itself consists
of five C++ files plus the generated PTX source. It links the parts of OpenUSD
it uses: \texttt{usd} for stages, \texttt{usdGeom} for geometry,
\texttt{usdShade} for materials, \texttt{ar} for resolving and opening assets,
and the base libraries \texttt{sdf}, \texttt{tf}, \texttt{gf} and~\texttt{vt}.

<<Build Dear ImGui and the viewer executable>>=
# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
add_library(imgui STATIC
  ${IMGUI_DIR}/imgui.cpp ${IMGUI_DIR}/imgui_draw.cpp ${IMGUI_DIR}/imgui_tables.cpp
  ${IMGUI_DIR}/imgui_widgets.cpp ${IMGUI_DIR}/imgui_demo.cpp
  ${IMGUI_DIR}/backends/imgui_impl_sdl3.cpp ${IMGUI_DIR}/backends/imgui_impl_sdlrenderer3.cpp)
target_include_directories(imgui PUBLIC ${IMGUI_DIR} ${IMGUI_DIR}/backends)
target_link_libraries(imgui PUBLIC SDL3::SDL3)

add_executable(UsdOptixViewer
  src/main.cpp src/App.cpp src/Scene.cpp src/OptixRenderer.cpp src/StbImage.cpp "${PTX_CPP}")
target_include_directories(UsdOptixViewer PRIVATE src ${OptiX_INCLUDE_DIR})
target_link_libraries(UsdOptixViewer PRIVATE
  imgui SDL3::SDL3 EnTT::EnTT usd usdGeom usdShade ar sdf tf gf vt
  CUDA::cudart CUDA::cuda_driver ${CMAKE_DL_LIBS})
# USD headers trigger a few deprecation warnings under C++20
target_compile_options(UsdOptixViewer PRIVATE -Wno-deprecated -Wno-deprecated-declarations)
@ Installation copies the executable and the test scenes. The libraries it
depends on stay where they are: the run-time search path (RPATH) of the
installed binary points to them, so the program starts without any
\texttt{LD\_LIBRARY\_PATH} settings.

<<Install the viewer>>=
# ---------------------------------------------------------------------------
# Installation: bin/UsdOptixViewer + sample scenes. RPATH points to the
# dependency libraries so the installed binary runs without LD_LIBRARY_PATH.
# ---------------------------------------------------------------------------
include(GNUInstallDirs)
set_target_properties(UsdOptixViewer PROPERTIES
  INSTALL_RPATH_USE_LINK_PATH ON
  INSTALL_RPATH "\$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
install(TARGETS UsdOptixViewer RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
install(DIRECTORY assets/ DESTINATION ${CMAKE_INSTALL_DATADIR}/UsdOptixViewer/assets)
@* Embedding a file. CMake has no command to turn a file into a C++ array,
but its scripting language is enough. We read the PTX as a hexadecimal string,
turn every pair of hex digits into a byte literal, and write a source file that
defines two symbols: the bytes followed by a terminating zero, and the size
without it. The renderer declares both as \textbf{extern} and hands
them to OptiX.

<<UsdOptixViewer/cmake/EmbedFile.cmake>>=
# Usage: cmake -DINPUT=file -DOUTPUT=file.cpp -DSYMBOL=name -P EmbedFile.cmake
# Writes a C++ source defining `extern const char SYMBOL[]` (NUL terminated)
# and `extern const size_t SYMBOL_size` (without the terminator).
file(READ "${INPUT}" content HEX)
string(LENGTH "${content}" hexLength)
math(EXPR size "${hexLength} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${content}")
file(WRITE "${OUTPUT}"
  "#include <cstddef>\n"
  "extern const char ${SYMBOL}[] = {${bytes}0x00};\n"
  "extern const size_t ${SYMBOL}_size = ${size};\n")
