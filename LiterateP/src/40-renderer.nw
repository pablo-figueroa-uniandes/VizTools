@ OptiX's host functions are not exported by any library. Instead, one header
defines a global table of function pointers,
\begin{center}\lpfile{optix\_function\_table\_definition.h},\end{center}
and another, \lpfile{optix\_stubs.h}, defines inline functions with the
documented names that call through that table; [[optixInit]] fills the table
from the driver. The definition header must be included in exactly one
translation unit of the program, and this is it.

<<Headers of the renderer implementation>>=
#include "OptixRenderer.h"

#include <algorithm>
#include <array>
#include <chrono>
#include <cmath>
#include <cstring>
#include <stdexcept>

#include <cuda_runtime.h>
#include <optix.h>
#include <optix_function_table_definition.h>
#include <optix_stubs.h>

#include "Scene.h"
@ The device programs reach us as OptiX-IR, the intermediate form that
\texttt{nvcc} produces for OptiX and that the build system compiles into the
executable (see <<Compile the device programs to OptiX-IR and embed them>>).
OptiX-IR is binary, so the size is what delimits it; the array also ends
with a zero byte, which the size excludes. Its bytes are \textbf{unsigned}
\textbf{char}, because a plain \textbf{char} is signed here and cannot hold
values above 127; [[optixModuleCreate]] takes them through a [[const char*]].

<<Declare the embedded OptiX-IR>>=
extern const unsigned char g_devicePrograms[];
extern const size_t g_devicePrograms_size;
@ Errors. Every CUDA and OptiX call returns a status code. Rather than test
each one by hand, we pass it to an overloaded [[check]] that throws an
exception carrying the name of the operation and the library's description of
the error. The exceptions are caught in [[init]] and in the application's
render loop, which turn them into a message for the user.

<<Error checking of CUDA and OptiX calls>>=
void check(cudaError_t r, const char* what)
{
    if (r != cudaSuccess)
        throw std::runtime_error(std::string(what) + ": " + cudaGetErrorString(r));
}

void check(OptixResult r, const char* what)
{
    if (r != OPTIX_SUCCESS)
        throw std::runtime_error(std::string(what) + ": " + optixGetErrorName(r));
}
@ Shader binding table records. OptiX finds the program to run for a ray
generation, a miss or a hit through the \emph{shader binding table} (SBT), an
array of records in device memory. Each record starts with an opaque header of
[[OPTIX_SBT_RECORD_HEADER_SIZE]] bytes, which identifies a program group, and
may continue with data of our own; records must be aligned to
[[OPTIX_SBT_RECORD_ALIGNMENT]] bytes. Our programs find all their data in the
launch parameters, so the payload type is the empty [[Empty]], and every
record is just an aligned header.

<<The shader binding table record type>>=
template <typename T>
struct alignas(OPTIX_SBT_RECORD_ALIGNMENT) SbtRecord
{
    alignas(OPTIX_SBT_RECORD_ALIGNMENT) char header[OPTIX_SBT_RECORD_HEADER_SIZE];
    T data;
};
struct Empty {};
@ CUDA's [[float3]] is a plain structure without operators on the host side,
and the camera code needs a handful of vector operations. These four
functions are all it takes; [[normalize]] leaves a zero vector unchanged
instead of dividing by zero.

<<Small vector helpers of the host>>=
float3 make3(const float v[3]) { return make_float3(v[0], v[1], v[2]); }
float3 scale(float3 a, float s) { return make_float3(a.x * s, a.y * s, a.z * s); }
float3 cross(float3 a, float3 b) { return make_float3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x); }
float3 normalize(float3 a)
{
    const float len = std::sqrt(a.x * a.x + a.y * a.y + a.z * a.z);
    return len > 0.0f ? scale(a, 1.0f / len) : a;
}
@* Mipmaps. A texture seen from far away covers many texels per pixel. If we
sampled only the full-resolution image, neighboring pixels would pick
unrelated texels and the picture would shimmer with moir\'e patterns. The
classical cure is a \emph{mip chain}: a sequence of images, each half the size
of the previous one, down to $1\times1$. The texture unit then reads from the
level whose texels match the footprint of a pixel; the device programs
estimate that footprint with ray differentials.

CUDA can store a mip chain but does not compute one, so we build the levels on
the CPU. Each texel of level $k+1$ is the average of a $2\times2$ block of
level~$k$ (a box filter). When a dimension is odd, the last row or column
simply has no partner, and we repeat the edge texel; when it is already~1, it
stays~1.

<<Compute the next mip level of a texture>>=
// Next mip level with a 2x2 box filter (edge texels are repeated for odd
// sizes). sRGB color channels are averaged in linear space.
std::vector<unsigned char> downsample(const std::vector<unsigned char>& src, int w, int h, bool srgb)
{
    <<The sRGB to linear lookup table>>
    const int nw = std::max(1, w / 2), nh = std::max(1, h / 2);
    std::vector<unsigned char> dst(size_t(nw) * nh * 4);
    for (int y = 0; y < nh; ++y)
        for (int x = 0; x < nw; ++x)
        {
            <<Gather the 2x2 block of source texels>>
            for (int c = 0; c < 4; ++c)
            {
                <<Average one channel of the block>>
            }
        }
    return dst;
}
@ Color textures are almost always stored in sRGB, a nonlinear encoding that
spends more of the 256 levels on dark tones. Averaging sRGB values directly
makes the smaller levels too dark: the average of black and white should be
light that is half as bright, whose sRGB code is 188, not 128. We therefore
convert to linear light, average, and convert back. The conversion from an
8-bit code $c/255$ to linear light is
$$\ell=\begin{cases}c/12.92, & \text{if } c\le0.04045;\\ \bigl((c+0.055)/1.055\bigr)^{2.4}, & \text{otherwise,}\end{cases}$$
and since it has only 256 possible inputs we tabulate it once, the first time
the function is called.

<<The sRGB to linear lookup table>>=
static const auto toLinear = [] {
    std::array<float, 256> lut{};
    for (int i = 0; i < 256; ++i)
    {
        const float c = i / 255.0f;
        lut[i] = c <= 0.04045f ? c / 12.92f : std::pow((c + 0.055f) / 1.055f, 2.4f);
    }
    return lut;
}();
@ The four source texels of output texel $(x,y)$ are those at $(2x,2y)$ to
$(2x+1,2y+1)$, clamped to the image; pixels are four bytes, RGBA.

<<Gather the 2x2 block of source texels>>=
const int x0 = std::min(2 * x, w - 1), x1 = std::min(2 * x + 1, w - 1);
const int y0 = std::min(2 * y, h - 1), y1 = std::min(2 * y + 1, h - 1);
const unsigned char* texels[4] = {&src[(size_t(y0) * w + x0) * 4], &src[(size_t(y0) * w + x1) * 4],
                                  &src[(size_t(y1) * w + x0) * 4], &src[(size_t(y1) * w + x1) * 4]};
unsigned char* out = &dst[(size_t(y) * nw + x) * 4];
@ The color channels of an sRGB texture go through linear space, and the
result is encoded again with the inverse of the curve above,
$$c=\begin{cases}12.92\,\ell, & \text{if } \ell\le0.0031308;\\ 1.055\,\ell^{1/2.4}-0.055, & \text{otherwise.}\end{cases}$$
The alpha channel, and every channel of a raw texture (normal maps, roughness,
metallic), is linear already and is averaged as integers, with $+2$ for
rounding to nearest.

<<Average one channel of the block>>=
if (srgb && c < 3)
{
    float sum = 0.0f;
    for (const unsigned char* t : texels)
        sum += toLinear[t[c]];
    const float l = sum * 0.25f;
    const float e = l <= 0.0031308f ? l * 12.92f : 1.055f * std::pow(l, 1.0f / 2.4f) - 0.055f;
    out[c] = (unsigned char)std::lround(std::clamp(e, 0.0f, 1.0f) * 255.0f);
}
else
    out[c] = (unsigned char)((texels[0][c] + texels[1][c] + texels[2][c] + texels[3][c] + 2) / 4);
@* Device buffers. Resizing to the current size is free; otherwise the old
block is released and a new one allocated. A size of zero leaves the buffer
empty, with a null pointer, which happens for a scene without textures or
without triangles.

<<Resize a device buffer>>=
// ---- DeviceBuffer ---------------------------------------------------------
void OptixRenderer::DeviceBuffer::resize(size_t bytes)
{
    if (bytes == size)
        return;
    free();
    if (bytes)
        check(cudaMalloc(reinterpret_cast<void**>(&ptr), bytes), "cudaMalloc");
    size = bytes;
}
@ Uploads are synchronous: they happen when a scene is loaded, not in the
render loop, so simplicity wins over overlap.

<<Upload host data to a device buffer>>=
void OptixRenderer::DeviceBuffer::upload(const void* data, size_t bytes)
{
    resize(bytes);
    if (bytes)
        check(cudaMemcpy(reinterpret_cast<void*>(ptr), data, bytes, cudaMemcpyHostToDevice), "cudaMemcpy");
}
@
<<Free a device buffer>>=
void OptixRenderer::DeviceBuffer::free()
{
    if (ptr)
        cudaFree(reinterpret_cast<void*>(ptr));
    ptr = 0;
    size = 0;
}
@ A mesh frees its buffers one by one, its acceleration structure among them,
and forgets the handle that pointed into that structure.

<<Free the buffers of a mesh>>=
void OptixRenderer::MeshBuffers::free()
{
    for (DeviceBuffer* b : {&positions, &normals, &uvs, &indices, &triMaterial, &gas})
        b->free();
    handle = 0;
}
@* Life and death of the renderer. The destructor only calls [[release]],
which does the work. If [[init]] never got as far as creating an OptiX
context, there is nothing to release. Otherwise we wait for the GPU to finish
any work in flight and release the resources in the reverse order of their
creation: the scene and the buffers first, then the pipeline, the program groups
and the module it was linked from, then the OptiX context, and last the CUDA
stream. The CUDA primary context itself is reference-counted by the runtime
and is released when the process exits. Because [[release]] may be followed
by another [[init]], it also resets every handle and the launch parameters,
so that the renderer looks freshly constructed.

<<Destroy the renderer>>=
// ---- OptixRenderer --------------------------------------------------------
OptixRenderer::~OptixRenderer()
{
    release();
}

void OptixRenderer::release()
{
    if (!m_context)
        return;
    cudaDeviceSynchronize();
    freeScene();
    for (DeviceBuffer* b : {&m_raygenRecord, &m_missRecords, &m_hitRecords, &m_colorBuffer, &m_accumBuffer,
                            &m_meshIdBuffer, &m_paramsBuffer, &m_viewAccum, &m_viewMeshIds, &m_viewParams})
        b->free();
    optixPipelineDestroy(m_pipeline);
    optixProgramGroupDestroy(m_raygenPG);
    for (OptixProgramGroup pg : m_missPG)
        optixProgramGroupDestroy(pg);
    optixProgramGroupDestroy(m_hitPG);
    optixModuleDestroy(m_module);
    optixDeviceContextDestroy(m_context);
    cudaStreamDestroy(m_stream);
    m_context = nullptr;
    m_module = nullptr;
    m_pipeline = nullptr;
    m_raygenPG = m_hitPG = nullptr;
    m_missPG[RAY_TYPE_RADIANCE] = m_missPG[RAY_TYPE_SHADOW] = nullptr;
    m_sbt = {};
    m_stream = nullptr;
    m_cuContext = nullptr;
    m_params = {};
    m_pixels.clear();
    m_meshIds.clear();
}
@ Initialization proceeds in three steps, any of which may throw; the
exception's message becomes the error text.

<<Initialize CUDA and OptiX>>=
bool OptixRenderer::init(std::string& error, const unsigned char* deviceUuid)
{
    try
    {
        <<Select the GPU and its primary context>>

        <<Create the OptiX device context>>

        <<Build the pipeline and set the default parameters>>
    }
    catch (const std::exception& e)
    {
        error = e.what();
        return false;
    }
    return true;
}
@ The workstation has two GPUs; one is plenty for an interactive viewer, so we
use device~0, unless a UUID names another. CUDA and Vulkan number the GPUs
independently, so the UUID is the only reliable way to find the GPU that the
XR runtime picked: we compare it with the UUID of each CUDA device. The CUDA
runtime creates a device's \emph{primary context}
lazily, on the first call that needs one; [[cudaFree(nullptr)]] is the
customary way to force that creation without doing anything else. OptiX,
however, is built on the lower-level driver API and wants a [[CUcontext]], so
we ask the driver for the context that is now current, which is that primary
context. Runtime and driver calls then share the same context, and memory
allocated with [[cudaMalloc]] is valid for OptiX. The stream orders all our
GPU work: acceleration builds, launches and copies.

<<Select the GPU and its primary context>>=
int deviceCount = 0;
check(cudaGetDeviceCount(&deviceCount), "cudaGetDeviceCount");
if (deviceCount == 0)
    throw std::runtime_error("no CUDA capable device found");
int device = 0;
cudaDeviceProp props{};
if (deviceUuid)
{
    // the XR runtime chose a GPU; CUDA numbers GPUs differently from Vulkan
    device = -1;
    for (int d = 0; d < deviceCount && device < 0; ++d)
        if (cudaGetDeviceProperties(&props, d) == cudaSuccess &&
            std::memcmp(props.uuid.bytes, deviceUuid, sizeof(props.uuid.bytes)) == 0)
            device = d;
    if (device < 0)
        throw std::runtime_error("no CUDA device matches the GPU of the XR runtime");
}
check(cudaSetDevice(device), "cudaSetDevice");
check(cudaFree(nullptr), "cudaFree");  // creates the primary context
check(cudaGetDeviceProperties(&props, device), "cudaGetDeviceProperties");
m_deviceName = props.name;
std::memcpy(m_deviceUuid.data(), props.uuid.bytes, m_deviceUuid.size());
check(cudaStreamCreate(&m_stream), "cudaStreamCreate");
if (cuCtxGetCurrent(&m_cuContext) != CUDA_SUCCESS)
    throw std::runtime_error("cuCtxGetCurrent failed");
@ [[optixInit]] locates the OptiX implementation inside the installed driver
and fills the function table; it fails if the driver is too old for the
headers we compiled against (OptiX~9.1 needs driver R590 or newer). The
device context is then created on top of the CUDA context, with default
options.

<<Create the OptiX device context>>=
check(optixInit(), "optixInit");
OptixDeviceContextOptions options = {};
check(optixDeviceContextCreate(m_cuContext, &options, &m_context), "optixDeviceContextCreate");
@ With a context in hand we compile the pipeline and fill in the shader
binding table, then give the launch parameters their initial values:
nothing selected, every feature on, and a light coming from above, to the
right and in front of the default camera. The device copy of the parameters
needs space for one [[LaunchParams]].

<<Build the pipeline and set the default parameters>>=
createPipeline();
buildSbt();
m_params.selectedMesh = kNoMesh;
m_params.shadows = 1u;
m_params.mipmaps = 1u;
m_params.normalMaps = 1u;
m_params.reflections = 1u;
const float light[3] = {0.4f, 0.8f, 0.45f};
setLightDir(light);
m_paramsBuffer.resize(sizeof(LaunchParams));
@* The pipeline. An OptiX \emph{pipeline} is the complete program run by a
launch. It is assembled from \emph{program groups}, which in turn refer to
entry functions inside \emph{modules}, which OptiX compiles from OptiX-IR.
Our single module holds all the device programs.

<<Create the OptiX pipeline>>=
void OptixRenderer::createPipeline()
{
    <<Module compile options>>

    <<Pipeline compile options>>

    <<Compile the embedded OptiX-IR into a module>>

    <<Create the ray generation program group>>

    <<Create the miss program groups>>

    <<Create the hit group>>

    <<Link the pipeline and set its stack size>>
}
@ The module is compiled with the default optimization level and the minimal
debug level, which keeps line information for profilers without slowing the
code down.

<<Module compile options>>=
OptixModuleCompileOptions moduleOptions = {};
moduleOptions.maxRegisterCount = OPTIX_COMPILE_DEFAULT_MAX_REGISTER_COUNT;
moduleOptions.optLevel = OPTIX_COMPILE_OPTIMIZATION_DEFAULT;
moduleOptions.debugLevel = OPTIX_COMPILE_DEBUG_LEVEL_MINIMAL;
@ The pipeline compile options must be identical for every module of a
pipeline, because they shape the calling convention between programs.
\begin{itemize}
\item The scene is a two-level structure: an instance acceleration structure
  (IAS) whose instances each point to the geometry acceleration structure
  (GAS) of one mesh. We promise OptiX exactly that, single-level instancing,
  so that it can drop support for deeper graphs and for motion.
\item The \emph{payload} is the set of 32-bit registers a ray carries between
  the program that traces it and the programs it triggers. Radiance rays use
  six: the three color components as float bits, the id of the mesh that was
  hit, the recursion depth, and the state of the random number generator.
  Shadow rays use only the first.
\item Triangles report two \emph{attributes}, their barycentric coordinates.
\item The launch parameters live in a constant-memory variable that the device
  code calls [[params]]; OptiX copies our parameter buffer into it.
\item Only built-in triangles are used, which lets OptiX drop support for
  other primitive types.
\end{itemize}

<<Pipeline compile options>>=
OptixPipelineCompileOptions pipelineOptions = {};
pipelineOptions.traversableGraphFlags = OPTIX_TRAVERSABLE_GRAPH_FLAG_ALLOW_SINGLE_LEVEL_INSTANCING;
pipelineOptions.numPayloadValues = 6;
pipelineOptions.numAttributeValues = 2;
pipelineOptions.exceptionFlags = OPTIX_EXCEPTION_FLAG_NONE;
pipelineOptions.pipelineLaunchParamsVariableName = "params";
pipelineOptions.usesPrimitiveTypeFlags = OPTIX_PRIMITIVE_TYPE_FLAGS_TRIANGLE;
@ The OptiX-IR is compiled to machine code for the installed GPU here, at run
time; that is what lets one executable run on any GPU that OptiX supports.
OptiX writes warnings and errors to a log buffer; [[logSize]] goes in as the
capacity and comes back as the length used, so it is reset before every call.
We do not print the log: on failure the error code already says what went
wrong, and the device programs were compiled and checked at build time.

<<Compile the embedded OptiX-IR into a module>>=
char log[2048];
size_t logSize = sizeof(log);
check(optixModuleCreate(m_context, &moduleOptions, &pipelineOptions,
                        reinterpret_cast<const char*>(g_devicePrograms), g_devicePrograms_size, log, &logSize,
                        &m_module),
      "optixModuleCreate");
@ Program groups name their entry functions by string. OptiX requires the
names to start with a prefix that tells the kind of program:
\texttt{\_\_raygen\_\_}, \texttt{\_\_miss\_\_}, \texttt{\_\_closesthit\_\_} or
\texttt{\_\_anyhit\_\_}. The ray generation program
is launched once per pixel.

<<Create the ray generation program group>>=
OptixProgramGroupOptions pgOptions = {};
OptixProgramGroupDesc desc = {};
desc.kind = OPTIX_PROGRAM_GROUP_KIND_RAYGEN;
desc.raygen.module = m_module;
desc.raygen.entryFunctionName = "__raygen__renderFrame";
logSize = sizeof(log);
check(optixProgramGroupCreate(m_context, &desc, 1, &pgOptions, log, &logSize, &m_raygenPG), "raygen group");
@ There are two ray types, radiance and shadow, and each has its own miss
program: a radiance ray that escapes returns the color of the sky, while a
shadow ray that escapes reports that the light is visible.

<<Create the miss program groups>>=
const char* missNames[RAY_TYPE_COUNT] = {"__miss__radiance", "__miss__shadow"};
for (int i = 0; i < RAY_TYPE_COUNT; ++i)
{
    desc = {};
    desc.kind = OPTIX_PROGRAM_GROUP_KIND_MISS;
    desc.miss.module = m_module;
    desc.miss.entryFunctionName = missNames[i];
    logSize = sizeof(log);
    check(optixProgramGroupCreate(m_context, &desc, 1, &pgOptions, log, &logSize, &m_missPG[i]), "miss group");
}
@ A \emph{hit group} bundles the programs run when a ray meets a triangle. The
closest-hit program shades the nearest intersection; the any-hit program runs
for every candidate intersection along the ray and is where alpha cutouts
discard the transparent parts of leaves and fences. A single hit group serves
both ray types: shadow rays are traced with closest-hit disabled, so for them
only the any-hit program matters, and that is exactly what a shadow test
needs.

<<Create the hit group>>=
desc = {};
desc.kind = OPTIX_PROGRAM_GROUP_KIND_HITGROUP;
desc.hitgroup.moduleCH = m_module;
desc.hitgroup.entryFunctionNameCH = "__closesthit__radiance";
desc.hitgroup.moduleAH = m_module;
desc.hitgroup.entryFunctionNameAH = "__anyhit__cutout";
logSize = sizeof(log);
check(optixProgramGroupCreate(m_context, &desc, 1, &pgOptions, log, &logSize, &m_hitPG), "hit group");
@ Linking needs the maximum depth of nested [[optixTrace]] calls. A camera
ray (depth~1) may hit a glossy surface whose closest-hit program traces a
reflection ray (depth~2); where that one lands, the closest-hit program traces
a shadow ray (depth~3). Nothing goes deeper: the reflected hit does not
reflect again, and shadow rays do not shade.

Recursion lives on a stack whose size OptiX must know. In general one adds up
the stack needs of all programs; OptiX~9 can do this for us from the call
depths: three levels of tracing, no continuation or direct callables, and a
traversable graph two levels deep, the IAS above the GASes.

<<Link the pipeline and set its stack size>>=
OptixProgramGroup groups[] = {m_raygenPG, m_missPG[0], m_missPG[1], m_hitPG};
OptixPipelineLinkOptions linkOptions = {};
linkOptions.maxTraceDepth = 3;  // camera -> reflection -> shadow
logSize = sizeof(log);
check(optixPipelineCreate(m_context, &pipelineOptions, &linkOptions, groups, 4, log, &logSize, &m_pipeline),
      "optixPipelineCreate");
// traversable graph depth 2: IAS -> GAS
check(optixPipelineSetStackSizeFromCallDepths(m_pipeline, linkOptions.maxTraceDepth, 0, 0, 0, 2),
      "optixPipelineSetStackSizeFromCallDepths");
@* The shader binding table. When a ray hits geometry, OptiX picks the hit
record at index
$$\hbox{instance offset}+\hbox{stride}\times\hbox{geometry index}+\hbox{ray offset},$$
where the instance offset is the [[sbtOffset]] of the instance that was hit,
the geometry index numbers the build inputs of its GAS, and stride and ray
offset are arguments of [[optixTrace]]; misses use the miss record named by
another argument. The device programs pass the ray type as the miss index, a
ray offset of~0 and a stride of [[RAY_TYPE_COUNT]]. Every instance has an
offset of~0 and every GAS a single build input (index~0), so every ray lands
on hit record~0: all meshes share one hit group, and the programs tell the
meshes apart by the instance id. The second record
exists only so that the table has one record per ray type, the layout that a
stride of [[RAY_TYPE_COUNT]] presumes.

<<Build the shader binding table>>=
void OptixRenderer::buildSbt()
{
    <<Pack the ray generation record>>

    <<Pack the miss records>>

    <<Pack the hit records>>

    <<Point the shader binding table at the records>>
}
@ Packing a record writes the header that identifies the program group;
then the record is copied to the GPU.

<<Pack the ray generation record>>=
SbtRecord<Empty> raygen;
check(optixSbtRecordPackHeader(m_raygenPG, &raygen), "pack raygen");
m_raygenRecord.upload(&raygen, sizeof(raygen));
@
<<Pack the miss records>>=
SbtRecord<Empty> miss[RAY_TYPE_COUNT];
for (int i = 0; i < RAY_TYPE_COUNT; ++i)
    check(optixSbtRecordPackHeader(m_missPG[i], &miss[i]), "pack miss");
m_missRecords.upload(miss, sizeof(miss));
@
<<Pack the hit records>>=
// Both ray types use the same record; the shadow ray disables closest-hit.
SbtRecord<Empty> hit[RAY_TYPE_COUNT];
for (int i = 0; i < RAY_TYPE_COUNT; ++i)
    check(optixSbtRecordPackHeader(m_hitPG, &hit[i]), "pack hit");
m_hitRecords.upload(hit, sizeof(hit));
@
<<Point the shader binding table at the records>>=
m_sbt.raygenRecord = m_raygenRecord.ptr;
m_sbt.missRecordBase = m_missRecords.ptr;
m_sbt.missRecordStrideInBytes = sizeof(SbtRecord<Empty>);
m_sbt.missRecordCount = RAY_TYPE_COUNT;
m_sbt.hitgroupRecordBase = m_hitRecords.ptr;
m_sbt.hitgroupRecordStrideInBytes = sizeof(SbtRecord<Empty>);
m_sbt.hitgroupRecordCount = RAY_TYPE_COUNT;
@* Loading a scene. [[setScene]] replaces everything that depends on the
scene: the materials, the textures, the meshes and the acceleration
structures. The materials and textures come first, because all meshes share
them; then every mesh is uploaded and gets its own acceleration structure;
last, one structure over all the meshes places them in the world.

Why one structure per mesh, rather than one over all the triangles of the
scene in world space? A USD stage describes each mesh in its own local space
and positions it with a transform, and keeping that split costs nothing on
the GPU. The ray-tracing hardware applies the transform as it descends from
the top structure into a mesh, so a mesh's vertices are uploaded exactly as
the scene holds them; only the small top structure would have to be rebuilt
to move an object. The instance also gives every hit a number for free, the
\emph{instance id}, which the device programs use both to find the mesh's
data and as the mesh id for picking.

<<Set the scene>>=
void OptixRenderer::setScene(const Scene& scene)
{
    <<Free the old scene and restart the accumulation>>
    <<Pack the materials for the device>>
    <<Upload the textures and publish the material tables>>

    <<Upload every mesh and build its acceleration structure>>
    <<Publish the mesh records>>

    <<Build the instance acceleration structure>>
}
@ The handle in the launch parameters points into the acceleration structures
that [[freeScene]] is about to release, so it is cleared first. Should
anything below throw, [[render]] then sees no scene rather than a dangling
handle. The accumulated image belongs to the old scene and restarts.

<<Free the old scene and restart the accumulation>>=
m_params.handle = 0;
m_params.frameIndex = 0;
freeScene();
@ Materials. The scene describes them with C++ types that
are convenient on the host ([[std::array]], [[bool]], [[ScalarInput]]); the
device wants the flat, CUDA-aligned [[MaterialData]] of
\lpfile{LaunchParams.h}. We convert field by field.

<<Pack the materials for the device>>=
std::vector<MaterialData> materials;
for (const Material& m : scene.materials())
{
    <<Conversions from host material fields>>
    <<Fill in one device material>>
}
m_materials.upload(materials.data(), materials.size() * sizeof(MaterialData));
@ Three small lambdas turn the host types into their device counterparts: a
four-component array into a [[float4]], a three-component one into a
[[float3]], and a scalar input (a constant, or a channel of a texture with a
scale and a bias) into a [[ScalarParam]].

<<Conversions from host material fields>>=
auto f4 = [](const std::array<float, 4>& v) { return make_float4(v[0], v[1], v[2], v[3]); };
auto f3 = [](const std::array<float, 3>& v) { return make_float3(v[0], v[1], v[2]); };
auto scalar = [](const ScalarInput& in) {
    return ScalarParam{in.value, in.texture, in.channel, in.scale, in.bias};
};
@ The fields follow the UsdPreviewSurface inputs: the diffuse texture's scale
and bias, those of the normal map and the specular color, the constant
colors, texture indices ($-1$ meaning none), roughness and metallic, the
alpha-cutout channel and threshold, the workflow flag and the index of
refraction. Texture indices refer to the table built by [[uploadTextures]].

<<Fill in one device material>>=
MaterialData d = {};
d.texScale = f4(m.scale);
d.texBias = f4(m.bias);
d.normalScale = f4(m.normalScale);
d.normalBias = f4(m.normalBias);
d.specScale = f4(m.specularScale);
d.specBias = f4(m.specularBias);
d.color = f3(m.color);
d.texture = m.texture;
d.specColor = f3(m.specularColor);
d.specTexture = m.specularTexture;
d.roughness = scalar(m.roughness);
d.metallic = scalar(m.metallic);
d.opacityTexture = m.opacityTexture;
d.opacityChannel = m.opacityChannel;
d.opacityThreshold = m.opacityThreshold;
d.normalTexture = m.normalTexture;
d.specularWorkflow = m.specularWorkflow ? 1 : 0;
d.ior = m.ior;
materials.push_back(d);
@ With the textures uploaded, the device addresses of the two shared tables
are known and go into the launch parameters.

<<Upload the textures and publish the material tables>>=
uploadTextures(scene);
m_params.materials = reinterpret_cast<const MaterialData*>(m_materials.ptr);
m_params.textures = reinterpret_cast<const cudaTextureObject_t*>(m_textureTable.ptr);
@ The meshes. For each mesh of the scene we upload its arrays, build its
geometry acceleration structure (GAS), and describe the instance that places
it in the world. Two host vectors collect the results: the [[MeshData]]
records through which the device programs find the arrays, and the
[[OptixInstance]]s for the top-level structure. Both are filled in the order
of the scene's meshes, so that index~$i$ of either is mesh~$i$.

<<Upload every mesh and build its acceleration structure>>=
// one GAS per mesh, in the mesh's own space
std::vector<MeshData> records;
std::vector<OptixInstance> instances;
for (const RenderMesh& mesh : scene.meshes())
{
    <<Upload the vertex data of a mesh>>

    <<Build the geometry acceleration structure of a mesh>>

    <<Place the mesh in the world with an instance>>
}
@ A [[RenderMesh]] holds its data in flat vectors of [[float]]s and
[[unsigned int]]s; their device element types ([[float3]], [[float2]],
[[uint3]]) have the same layout, so the vectors are copied as they are. The
scene has already welded the corners of the faces into shared vertices, which
is why one index can address the position, the normal and the texture
coordinates alike. A mesh without normals or without texture coordinates
uploads an empty vector, and its record holds a null pointer there.

<<Upload the vertex data of a mesh>>=
MeshBuffers& b = m_meshes.emplace_back();
b.positions.upload(mesh.positions.data(), mesh.positions.size() * sizeof(float));
b.normals.upload(mesh.normals.data(), mesh.normals.size() * sizeof(float));
b.uvs.upload(mesh.uvs.data(), mesh.uvs.size() * sizeof(float));
b.indices.upload(mesh.indices.data(), mesh.indices.size() * sizeof(unsigned int));
b.triMaterial.upload(mesh.triMaterial.data(), mesh.triMaterial.size() * sizeof(unsigned int));
records.push_back({reinterpret_cast<const float3*>(b.positions.ptr),
                   reinterpret_cast<const float3*>(b.normals.ptr), reinterpret_cast<const float2*>(b.uvs.ptr),
                   reinterpret_cast<const uint3*>(b.indices.ptr),
                   reinterpret_cast<const unsigned int*>(b.triMaterial.ptr)});
@ OptiX builds a bounding volume hierarchy over the triangles of the mesh, the
\emph{geometry acceleration structure}, which the hardware ray-tracing cores
traverse. The mesh is one build input: an indexed triangle array of
[[float3]] positions in the mesh's local space and [[uint3]] index triplets,
with one SBT record.

The geometry flag deserves a word. The usual advice for opaque geometry is the flag
\begin{center}[[OPTIX_GEOMETRY_FLAG_DISABLE_ANYHIT]],\end{center}
which spares the traversal a call per candidate hit. Alpha cutouts need the
any-hit program, though, so the flag is [[OPTIX_GEOMETRY_FLAG_NONE]]; for
opaque materials the program returns at once.

<<Build the geometry acceleration structure of a mesh>>=
// any-hit stays enabled for alpha cutouts; it returns early for opaque materials
const unsigned int flags[] = {OPTIX_GEOMETRY_FLAG_NONE};
OptixBuildInput input = {};
input.type = OPTIX_BUILD_INPUT_TYPE_TRIANGLES;
OptixBuildInputTriangleArray& tri = input.triangleArray;
tri.vertexFormat = OPTIX_VERTEX_FORMAT_FLOAT3;
tri.vertexStrideInBytes = sizeof(float3);
tri.numVertices = unsigned(mesh.vertexCount());
tri.vertexBuffers = &b.positions.ptr;
tri.indexFormat = OPTIX_INDICES_FORMAT_UNSIGNED_INT3;
tri.indexStrideInBytes = sizeof(uint3);
tri.numIndexTriplets = unsigned(mesh.triangleCount());
tri.indexBuffer = b.indices.ptr;
tri.flags = flags;
tri.numSbtRecords = 1;
b.handle = buildAccel(input, b.gas);
@ An instance couples a GAS with the affine transform that takes it from the
mesh's space to the world. OptiX wants that transform as the first three rows
of a $4\times4$ matrix, row-major, acting on column vectors; the scene stores
[[toWorld]] in exactly that form, so it is copied as it is.

\begin{sloppypar}The [[instanceId]] is a 28-bit number of our choosing that the device
programs read back with [[optixGetInstanceId]]. We set it to the index of the
mesh, which makes it at once the index into the [[MeshData]] records and the
mesh id written into the picking buffer. All rays may hit every instance (the
visibility mask is all ones), every instance uses the one hit record
(offset~0), and none overrides the geometry flags.\end{sloppypar}

<<Place the mesh in the world with an instance>>=
OptixInstance instance = {};
std::copy(mesh.toWorld.begin(), mesh.toWorld.end(), instance.transform);
instance.instanceId = unsigned(instances.size());  // the mesh id
instance.visibilityMask = 255;
instance.sbtOffset = 0;
instance.flags = OPTIX_INSTANCE_FLAG_NONE;
instance.traversableHandle = b.handle;
instances.push_back(instance);
@ The records go to the device as one array, which the launch parameters
point to. A scene without meshes stops here: the handle stays zero, and
[[render]] then simply paints the background.

<<Publish the mesh records>>=
m_meshRecords.upload(records.data(), records.size() * sizeof(MeshData));
m_params.meshes = reinterpret_cast<const MeshData*>(m_meshRecords.ptr);
if (instances.empty())
    return;
@ The instances themselves must also live in device memory, where the build
reads them. Built over them, the \emph{instance acceleration structure} (IAS)
is a hierarchy of the instances' world-space bounding boxes; its handle is
the one that every [[optixTrace]] starts from.

<<Build the instance acceleration structure>>=
// the IAS places every mesh in the world
m_instances.upload(instances.data(), instances.size() * sizeof(OptixInstance));
OptixBuildInput input = {};
input.type = OPTIX_BUILD_INPUT_TYPE_INSTANCES;
input.instanceArray.instances = m_instances.ptr;
input.instanceArray.numInstances = unsigned(instances.size());
m_params.handle = buildAccel(input, m_ias);
@ Building an acceleration structure is the same for both levels. The scene
is static once loaded, so we ask for the structure that traces fastest, at
the price of a slower build, and do not request updates or compaction.

<<Build an acceleration structure>>=
OptixTraversableHandle OptixRenderer::buildAccel(const OptixBuildInput& input, DeviceBuffer& output)
{
    <<Choose the acceleration structure build options>>

    <<Run the build and wait for it>>
}
@
<<Choose the acceleration structure build options>>=
OptixAccelBuildOptions accelOptions = {};
accelOptions.buildFlags = OPTIX_BUILD_FLAG_PREFER_FAST_TRACE;
accelOptions.operation = OPTIX_BUILD_OPERATION_BUILD;
@ OptiX first tells us how much memory the build needs: scratch space for the
build itself and room for the result, which goes into the caller's buffer.
The build runs on our stream and returns the \emph{traversable handle}; we
wait for it before releasing the scratch buffer. Waiting after every mesh
serializes the builds, but they happen once per scene, and it keeps only one
scratch buffer alive at a time.

<<Run the build and wait for it>>=
OptixAccelBufferSizes sizes = {};
check(optixAccelComputeMemoryUsage(m_context, &accelOptions, &input, 1, &sizes), "optixAccelComputeMemoryUsage");
DeviceBuffer temp;
temp.resize(sizes.tempSizeInBytes);
output.resize(sizes.outputSizeInBytes);
OptixTraversableHandle handle = 0;
check(optixAccelBuild(m_context, m_stream, &accelOptions, &input, 1, temp.ptr, temp.size, output.ptr, output.size,
                      &handle, nullptr, 0),
      "optixAccelBuild");
check(cudaStreamSynchronize(m_stream), "accel build");
temp.free();
return handle;
@ [[freeScene]] undoes [[setScene]]: the buffers of every mesh, the records,
the instances and their structure, the materials and the textures.

<<Free the scene>>=
void OptixRenderer::freeScene()
{
    for (MeshBuffers& b : m_meshes)
        b.free();
    m_meshes.clear();
    for (DeviceBuffer* b : {&m_meshRecords, &m_instances, &m_ias, &m_materials})
        b->free();
    freeTextures();
}
@* Textures. Every texture of the scene becomes a CUDA \emph{mipmapped array}
holding its full mip chain, and a \emph{texture object}: a 64-bit handle that
combines the array with a description of how to sample it. The handles go
into a table on the device, indexed by the texture numbers stored in the
materials.

<<Upload the textures>>=
void OptixRenderer::uploadTextures(const Scene& scene)
{
    freeTextures();
    for (const Texture& t : scene.textures())
    {
        <<Allocate a mipmapped array for the texture>>
        <<Upload every mip level>>

        <<Describe how the texture is sampled>>
        <<Create the texture object>>
    }
    m_textureTable.upload(m_textureObjects.data(), m_textureObjects.size() * sizeof(cudaTextureObject_t));
}
@ A chain that halves down to $1\times1$ has $1+\lfloor\log_2\max(w,h)\rfloor$
levels. Texels are four unsigned bytes, as decoded by the scene.

<<Allocate a mipmapped array for the texture>>=
// full mip chain, down to 1x1
const unsigned levels = 1u + unsigned(std::floor(std::log2(double(std::max(t.width, t.height)))));
const cudaChannelFormatDesc format = cudaCreateChannelDesc<uchar4>();
cudaMipmappedArray_t mipmaps = nullptr;
check(cudaMallocMipmappedArray(&mipmaps, &format, make_cudaExtent(size_t(t.width), size_t(t.height), 0),
                               levels),
      "cudaMallocMipmappedArray");
m_textureArrays.push_back(mipmaps);
@ Level~0 is the image itself. After uploading each level we compute the next
one from it with [[downsample]], which halves the dimensions the same way CUDA
does, never going below~1.

<<Upload every mip level>>=
std::vector<unsigned char> level = t.rgba;
int w = t.width, h = t.height;
for (unsigned l = 0; l < levels; ++l)
{
    cudaArray_t array = nullptr;
    check(cudaGetMipmappedArrayLevel(&array, mipmaps, l), "cudaGetMipmappedArrayLevel");
    check(cudaMemcpy2DToArray(array, 0, 0, level.data(), size_t(w) * 4, size_t(w) * 4, size_t(h),
                              cudaMemcpyHostToDevice),
          "texture upload");
    if (l + 1 < levels)
    {
        level = downsample(level, w, h, t.srgb);
        w = std::max(1, w / 2);
        h = std::max(1, h / 2);
    }
}
@ The sampling description is where the texture hardware earns its keep.
\begin{itemize}
\item The USD wrap modes map onto CUDA address modes: \texttt{repeat} to
  wrap, \texttt{mirror} to mirror, \texttt{clamp} to clamp, and
  \texttt{black} to border, whose border color is zero.
\item Filtering is \emph{trilinear}: bilinear within a level, and linear
  between the two levels nearest to the requested one.
\item Up to eight anisotropic samples are taken along the longer axis of a
  pixel's footprint. This only works with explicit gradients, which is why the
  device programs sample with [[tex2DGrad]]; it keeps floors seen at grazing
  angles sharp instead of blurring them to the coarsest level the short axis
  would allow.
\item Texels are read as normalized floats in $[0,1]$, addressed with
  normalized coordinates.
\item For sRGB textures the hardware converts each texel to linear light
  \emph{before} filtering, which is the correct order and costs nothing.
\end{itemize}

<<Describe how the texture is sampled>>=
cudaResourceDesc resource = {};
resource.resType = cudaResourceTypeMipmappedArray;
resource.res.mipmap.mipmap = mipmaps;
cudaTextureDesc desc = {};
auto mode = [](TextureWrap w) {
    switch (w)
    {
    case TextureWrap::Mirror: return cudaAddressModeMirror;
    case TextureWrap::Clamp: return cudaAddressModeClamp;
    case TextureWrap::Black: return cudaAddressModeBorder;
    default: return cudaAddressModeWrap;
    }
};
desc.addressMode[0] = mode(t.wrapS);
desc.addressMode[1] = mode(t.wrapT);
desc.filterMode = cudaFilterModeLinear;
desc.mipmapFilterMode = cudaFilterModeLinear;
desc.maxMipmapLevelClamp = float(levels - 1);
desc.maxAnisotropy = 8;
desc.readMode = cudaReadModeNormalizedFloat;
desc.normalizedCoords = 1;
desc.sRGB = t.srgb ? 1 : 0;  // the hardware converts sRGB texels to linear
@
<<Create the texture object>>=
cudaTextureObject_t object = 0;
check(cudaCreateTextureObject(&object, &resource, &desc, nullptr), "cudaCreateTextureObject");
m_textureObjects.push_back(object);
@ Texture objects must be destroyed before the arrays they refer to.

<<Free the textures>>=
void OptixRenderer::freeTextures()
{
    for (cudaTextureObject_t object : m_textureObjects)
        cudaDestroyTextureObject(object);
    for (cudaMipmappedArray_t mipmaps : m_textureArrays)
        cudaFreeMipmappedArray(mipmaps);
    m_textureObjects.clear();
    m_textureArrays.clear();
    m_textureTable.free();
}
@* The image and the camera. The output buffers follow the size of the
viewport. A minimized or collapsed viewport may report a zero size, which we
round up to one pixel so that every buffer stays valid. Resizing restarts the
accumulation, since the old sums belong to other pixels. The accumulation
buffer holds one [[float4]] per pixel: the sum of the sample colors, and in
the fourth component the number of samples.

<<Resize the output image>>=
void OptixRenderer::resize(unsigned int width, unsigned int height)
{
    width = width ? width : 1;
    height = height ? height : 1;
    if (width == m_params.width && height == m_params.height)
        return;
    m_params.width = width;
    m_params.height = height;
    m_colorBuffer.resize(size_t(width) * height * sizeof(uchar4));
    m_accumBuffer.resize(size_t(width) * height * sizeof(float4));
    m_params.accumBuffer = reinterpret_cast<float4*>(m_accumBuffer.ptr);
    m_params.frameIndex = 0;
    m_meshIdBuffer.resize(size_t(width) * height * sizeof(unsigned int));
    m_params.colorBuffer = reinterpret_cast<uchar4*>(m_colorBuffer.ptr);
    m_params.meshIdBuffer = reinterpret_cast<unsigned int*>(m_meshIdBuffer.ptr);
    m_pixels.resize(size_t(width) * height);
    m_meshIds.resize(size_t(width) * height);
}
@ A pinhole camera is described to the device by its eye point and three
vectors. Let $\mathbf w$ be the unit vector from the eye towards the target,
$\mathbf u=\mathbf w\times\mathbf{up}$ normalized (pointing right), and
$\mathbf v=\mathbf u\times\mathbf w$ (pointing up). If $\phi$ is the vertical
field of view and $a$ the aspect ratio, the image plane at distance~1 spans
$\pm\tan(\phi/2)$ vertically and $\pm a\tan(\phi/2)$ horizontally. Scaling
$\mathbf u$ and $\mathbf v$ by those half-extents lets the ray generation
program write the direction through normalized device coordinates
$(x,y)\in[-1,1]^2$ simply as $\mathbf w+x\,\mathbf u+y\,\mathbf v$. The
aspect ratio is taken from the current image size, so the camera must be set
after [[resize]]. The orbit camera sees everything in front of it, so its
clipping range is $[0,10^{16}]$.

<<Set the camera>>=
void OptixRenderer::setCamera(const float eye[3], const float target[3], const float up[3], float fovYDeg)
{
    const float forward[3] = {target[0] - eye[0], target[1] - eye[1], target[2] - eye[2]};
    const float halfH = std::tan(fovYDeg * 0.5f * float(M_PI) / 180.0f);
    const float aspect = m_params.height ? float(m_params.width) / float(m_params.height) : 1.0f;
    setCameraView(eye, forward, up, halfH * aspect, halfH, false, 0.0f, 1e16f);
}
@ The general form builds the same frame from a forward direction and scales
$\mathbf u$ and $\mathbf v$ by the half-extents it is given. Those already
include the aspect ratio: for a USD camera the application decides how the
camera's window is fitted to the viewport.

<<Set a general camera view>>=
void OptixRenderer::setCameraView(const float eye[3], const float forward[3], const float up[3], float halfWidth,
                                  float halfHeight, bool orthographic, float clipNear, float clipFar)
{
    const float3 w = normalize(make3(forward));
    const float3 u = normalize(cross(w, make3(up)));
    const float3 v = cross(u, w);
    m_params.camera = {make3(eye), scale(u, halfWidth), scale(v, halfHeight), w, orthographic ? 1u : 0u,
                       clipNear, clipFar};
}
@ The light is directional; the device programs want the unit vector that
points towards it.

<<Set the light direction>>=
void OptixRenderer::setLightDir(const float dir[3])
{
    m_params.lightDir = normalize(make3(dir));
}
@* Rendering. Each call adds one sample per pixel. If there is no image or no
scene there is nothing to trace: an empty scene is painted in a dark gray and
reports no mesh anywhere.

<<Render one progressive sample>>=
void OptixRenderer::render()
{
    <<Handle an empty image or scene>>
    <<Launch one sample per pixel>>
    <<Download the image and the picking ids>>
}
@
<<Handle an empty image or scene>>=
if (!m_params.width || !m_params.height)
    return;
const auto start = std::chrono::steady_clock::now();
if (!m_params.handle)
{
    // Nothing to trace: clear to the background color.
    std::fill(m_pixels.begin(), m_pixels.end(), make_uchar4(40, 42, 48, 255));
    std::fill(m_meshIds.begin(), m_meshIds.end(), kNoMesh);
    return;
}
@ The host copy of the launch parameters goes to the device, and the pipeline
is launched over a two-dimensional grid with one thread per pixel. Both
operations are queued on the same stream, so the launch sees the new
parameters; the frame index tells the ray generation program whether to start
a new sum (frame~0) or add to the existing one.

<<Launch one sample per pixel>>=
check(cudaMemcpyAsync(reinterpret_cast<void*>(m_paramsBuffer.ptr), &m_params, sizeof(m_params),
                      cudaMemcpyHostToDevice, m_stream),
      "upload params");
check(optixLaunch(m_pipeline, m_stream, m_paramsBuffer.ptr, sizeof(LaunchParams), &m_sbt, m_params.width,
                  m_params.height, 1),
      "optixLaunch");
@ The averaged image comes back after every sample, so the user sees it
converge. The mesh ids are another story: the first sample shoots its rays
through the pixel centers and is the only one that writes them, because later
samples jitter their rays inside the pixel, and a jittered id would flicker
along the edges of objects. We download them only after that first sample.
Then we wait for the stream, count the sample, and record how long it took,
for the status bar.

<<Download the image and the picking ids>>=
check(cudaMemcpyAsync(m_pixels.data(), reinterpret_cast<void*>(m_colorBuffer.ptr), m_colorBuffer.size,
                      cudaMemcpyDeviceToHost, m_stream),
      "download color");
if (m_params.frameIndex == 0)
    check(cudaMemcpyAsync(m_meshIds.data(), reinterpret_cast<void*>(m_meshIdBuffer.ptr), m_meshIdBuffer.size,
                          cudaMemcpyDeviceToHost, m_stream),
          "download ids");
check(cudaStreamSynchronize(m_stream), "render");
++m_params.frameIndex;
m_lastRenderMs = std::chrono::duration<float, std::milli>(std::chrono::steady_clock::now() - start).count();
@ An eye of the headset. The launch parameters are copied, so the desktop's
camera, image and sample count stay as they are, and the copy is pointed at
the eye's camera, its size, the target buffer, and the scratch buffers for the
sums and the mesh ids. The ray generation program then works exactly as for
the desktop: launch~$s$ adds sample~$s$ to the sums and writes the running
average to the target, so after the last launch the target holds the average
of all the samples. The first sample goes through the pixel centres and the
others are jittered, which antialiases the edges. All launches use one device
copy of the parameters; that is safe because the copy before each launch is
queued on the same stream, after the previous launch.

An empty scene still owes the headset an image: the background color is
written into the target with a 32-bit memset, whose word holds the bytes
$(40, 42, 48, 255)$ in little-endian order. The function returns only when
the GPU has finished, because the XR runtime reads the buffer next.

<<Render one view into a device buffer>>=
void OptixRenderer::renderView(const Camera& camera, unsigned int width, unsigned int height, uchar4* target,
                               unsigned int samples)
{
    const size_t pixels = size_t(width) * height;
    if (!m_params.handle)
    {
        // nothing to trace: the background color (40, 42, 48) as one 32-bit word
        if (cuMemsetD32Async(CUdeviceptr(target), 0xff302a28u, pixels, m_stream) != CUDA_SUCCESS)
            throw std::runtime_error("cuMemsetD32Async failed");
        check(cudaStreamSynchronize(m_stream), "renderView");
        return;
    }
    m_viewAccum.resize(pixels * sizeof(float4));
    m_viewMeshIds.resize(pixels * sizeof(unsigned int));
    m_viewParams.resize(sizeof(LaunchParams));
    LaunchParams params = m_params;
    params.camera = camera;
    params.width = width;
    params.height = height;
    params.colorBuffer = target;
    params.accumBuffer = reinterpret_cast<float4*>(m_viewAccum.ptr);
    params.meshIdBuffer = reinterpret_cast<unsigned int*>(m_viewMeshIds.ptr);
    for (unsigned int s = 0; s < std::max(samples, 1u); ++s)
    {
        params.frameIndex = s;
        check(cudaMemcpyAsync(reinterpret_cast<void*>(m_viewParams.ptr), &params, sizeof(params),
                              cudaMemcpyHostToDevice, m_stream),
              "upload view params");
        check(optixLaunch(m_pipeline, m_stream, m_viewParams.ptr, sizeof(LaunchParams), &m_sbt, width, height, 1),
              "optixLaunch");
    }
    check(cudaStreamSynchronize(m_stream), "renderView");
}
@ Picking reads the host copy of the ids; coordinates outside the image hit
nothing.

<<Look up the mesh under a pixel>>=
unsigned int OptixRenderer::meshIdAt(unsigned int x, unsigned int y) const
{
    if (x >= m_params.width || y >= m_params.height)
        return kNoMesh;
    return m_meshIds[size_t(y) * m_params.width + x];
}
