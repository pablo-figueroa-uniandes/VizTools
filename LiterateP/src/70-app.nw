@ The View menu frames the stage or the selection and controls the image:
shadows, texture mipmaps, normal maps, traced reflections, the direction of
the light and the field of view. ImGui's check-mark items toggle the [[bool]]
they are given and report the change, and every change sets
[[m_needsRender]], so that the progressive rendering starts over with the new
settings. A USD camera has its own field of view, so the slider is disabled
while we look through one.

<<The View menu>>=
if (ImGui::BeginMenu("View"))
{
    if (ImGui::MenuItem("Frame all"))
        frameBounds(m_scene.boundsMin(), m_scene.boundsMax());
    if (ImGui::MenuItem("Frame selection", "F", false, !m_selected.IsEmpty()))
        frameSelection();
    if (ImGui::MenuItem("Shadows", nullptr, &m_shadows))
        m_needsRender = true;
    if (ImGui::MenuItem("Texture mipmaps", nullptr, &m_mipmaps))
        m_needsRender = true;
    if (ImGui::MenuItem("Normal maps", nullptr, &m_normalMaps))
        m_needsRender = true;
    if (ImGui::MenuItem("Reflections", nullptr, &m_reflections))
        m_needsRender = true;
    if (ImGui::SliderFloat3("Light direction", m_light, -1.0f, 1.0f))
        m_needsRender = true;
    ImGui::BeginDisabled(m_camera >= 0);  // a USD camera has its own field of view
    if (ImGui::SliderFloat("Field of view", &m_fovY, 15.0f, 100.0f))
        m_needsRender = true;
    ImGui::EndDisabled();
    ImGui::EndMenu();
