keeps the view where it is, as described in
<<Hand the view of a USD camera to the orbit camera>>.

<<The Camera menu>>=
if (ImGui::BeginMenu("Camera"))
{
    if (ImGui::MenuItem("Orbit camera", nullptr, m_camera < 0))
